{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskPayload",
  "description": "GET /v1/tasks/next reply. Mirrors TaskPayload and the *Params types in frontend/src/features/assessment/telemetry/types.ts, plus the rules the client enforces (assessment_engine/HANDOVER.md, Member 5). dynamic_cache/tests/test_schema.py (when frontend/ is present) fails when types.ts and this file drift apart.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "dimension",
    "schema_type",
    "params",
    "surface_seed"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_:.-]{1,48}$"
    },
    "dimension": {
      "enum": [
        "working_memory",
        "pattern_induction",
        "executive_function",
        "spatial_orientation",
        "processing_speed",
        "episodic_memory"
      ]
    },
    "schema_type": {
      "enum": [
        "n_back",
        "stroop",
        "matrix",
        "mental_rotation",
        "relational",
        "tower",
        "ufov",
        "mst",
        "stop_signal",
        "pal",
        "flanker"
      ]
    },
    "params": {
      "type": "object"
    },
    "surface_seed": {
      "type": "integer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "n_back"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "working_memory"
          },
          "params": {
            "$ref": "#/definitions/NBackParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "stroop"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "executive_function"
          },
          "params": {
            "$ref": "#/definitions/StroopParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "matrix"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "pattern_induction"
          },
          "params": {
            "$ref": "#/definitions/MatrixParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "mental_rotation"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "spatial_orientation"
          },
          "params": {
            "$ref": "#/definitions/RotationParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "relational"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "pattern_induction"
          },
          "params": {
            "$ref": "#/definitions/RelationalParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "tower"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "executive_function"
          },
          "params": {
            "$ref": "#/definitions/TowerParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "ufov"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "processing_speed"
          },
          "params": {
            "$ref": "#/definitions/UfovParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "mst"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "episodic_memory"
          },
          "params": {
            "$ref": "#/definitions/MstParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "stop_signal"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "executive_function"
          },
          "params": {
            "$ref": "#/definitions/StopSignalParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "pal"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "episodic_memory"
          },
          "params": {
            "$ref": "#/definitions/PalParams"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_type": {
            "const": "flanker"
          }
        }
      },
      "then": {
        "properties": {
          "dimension": {
            "const": "executive_function"
          },
          "params": {
            "$ref": "#/definitions/FlankerParams"
          }
        }
      }
    }
  ],
  "definitions": {
    "ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    },
    "intPair": {
      "type": "array",
      "items": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "additionalItems": false,
      "minItems": 2
    },
    "numPair": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "additionalItems": false,
      "minItems": 2
    },
    "Glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "count",
        "color",
        "rotation_deg"
      ],
      "properties": {
        "shape": {
          "enum": [
            "circle",
            "square",
            "triangle",
            "diamond"
          ]
        },
        "count": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "color": {
          "description": "CSS colour names that svg.tsx GLYPH_COLORS maps to theme tokens; any other name paints in ink.",
          "enum": [
            "blue",
            "red",
            "green",
            "yellow"
          ]
        },
        "rotation_deg": {
          "type": "number"
        }
      }
    },
    "Poly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points",
        "edges"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/numPair"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "additionalItems": false,
            "minItems": 2
          }
        }
      }
    },
    "Statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a",
        "rel",
        "b"
      ],
      "properties": {
        "a": {
          "type": "string",
          "pattern": "^[a-z]{2,8}$"
        },
        "rel": {
          "enum": [
            "same",
            "opposite",
            "more",
            "less",
            "before",
            "after",
            "contains"
          ]
        },
        "b": {
          "type": "string",
          "pattern": "^[a-z]{2,8}$"
        }
      }
    },
    "NBackParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "stimulus_ms",
        "interval_ms",
        "streams",
        "trials"
      ],
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "stimulus_ms": {
          "$ref": "#/definitions/ms"
        },
        "interval_ms": {
          "$ref": "#/definitions/ms"
        },
        "streams": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "position",
              "symbol"
            ]
          }
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pos",
              "symbol",
              "rule",
              "trial_type",
              "answer"
            ],
            "properties": {
              "pos": {
                "description": "[row, col] on the 3x3 grid",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "items": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2
                      },
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2
                      }
                    ],
                    "additionalItems": false,
                    "minItems": 2
                  }
                ]
              },
              "symbol": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2
                  }
                ]
              },
              "rule": {
                "enum": [
                  "position",
                  "symbol",
                  "parity"
                ]
              },
              "trial_type": {
                "enum": [
                  "target",
                  "standard",
                  "lure_minus",
                  "lure_plus",
                  "switch"
                ]
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "position": {
                    "type": "boolean"
                  },
                  "symbol": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "StroopParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "colors",
        "trials",
        "time_limit_ms"
      ],
      "$comment": "Inks come from StroopInk; a block uses one preset (stroop.py INK_PRESETS).",
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 2,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/StroopInk"
          }
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "word",
              "ink",
              "answer"
            ],
            "properties": {
              "word": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              },
              "ink": {
                "$ref": "#/definitions/StroopInk"
              },
              "answer": {
                "$ref": "#/definitions/StroopInk"
              }
            }
          }
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        }
      }
    },
    "StroopInk": {
      "$comment": "Every ink Stroop.tsx INK maps to a theme token: the classic preset (red, green, blue, yellow) and the cvd_safe preset (blue, yellow, red, black; a block with black runs on the light plate).",
      "enum": [
        "red",
        "green",
        "blue",
        "yellow",
        "black"
      ]
    },
    "MatrixParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells",
        "options",
        "answer",
        "time_limit_ms"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/Glyph"
              }
            ]
          },
          "contains": {
            "type": "null"
          },
          "$comment": "Draft-07 can say 'at least one null' only; solvers.solve_matrix rejects more than one."
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/Glyph"
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        }
      }
    },
    "RotationParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trials",
        "time_limit_ms"
      ],
      "properties": {
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cells",
              "angle_deg",
              "mirrored",
              "answer"
            ],
            "properties": {
              "cells": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/definitions/intPair"
                }
              },
              "angle_deg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "mirrored": {
                "type": "boolean"
              },
              "answer": {
                "enum": [
                  "same",
                  "different"
                ]
              }
            }
          }
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        }
      }
    },
    "RelationalParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_trials",
        "time_limit_ms",
        "levels"
      ],
      "properties": {
        "n_trials": {
          "type": "integer",
          "minimum": 1
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "premises",
                "question",
                "inverted",
                "hops",
                "answer"
              ],
              "properties": {
                "premises": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/definitions/Statement"
                  }
                },
                "question": {
                  "$ref": "#/definitions/Statement"
                },
                "inverted": {
                  "type": "boolean"
                },
                "hops": {
                  "type": "integer",
                  "minimum": 1
                },
                "answer": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "TowerParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacities",
        "start",
        "goal",
        "l_min",
        "optimal_moves",
        "counter_intuitive"
      ],
      "properties": {
        "capacities": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "start": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]$"
            }
          }
        },
        "goal": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z]$"
            }
          }
        },
        "l_min": {
          "type": "integer",
          "minimum": 1
        },
        "optimal_moves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "additionalItems": false,
            "minItems": 2
          }
        },
        "counter_intuitive": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        }
      }
    },
    "UfovParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_grid_ms",
        "similarity",
        "mask_noise",
        "trials"
      ],
      "properties": {
        "duration_grid_ms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "similarity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mask_noise": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "central",
              "peripheral_dir",
              "distractors"
            ],
            "properties": {
              "central": {
                "enum": [
                  "A",
                  "B"
                ]
              },
              "peripheral_dir": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "distractors": {
                "type": "array",
                "maxItems": 23,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dir",
                    "ring"
                  ],
                  "properties": {
                    "dir": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "ring": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "MstParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encode_ms",
        "encode",
        "test"
      ],
      "properties": {
        "encode_ms": {
          "$ref": "#/definitions/ms"
        },
        "encode": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/Poly"
          }
        },
        "test": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "kind",
              "delta"
            ],
            "properties": {
              "item": {
                "$ref": "#/definitions/Poly"
              },
              "kind": {
                "enum": [
                  "old",
                  "lure",
                  "new"
                ]
              },
              "delta": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "StopSignalParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_limit_ms",
        "fixation_ms",
        "ssd_start_ms",
        "ssd_step_ms",
        "trials"
      ],
      "$comment": "Stop Light (StopSignal.tsx). ssd_start_ms may be 0 (a signal with the arrow); the client clamps the staircase to [0, time_limit_ms].",
      "properties": {
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        },
        "fixation_ms": {
          "$ref": "#/definitions/ms"
        },
        "ssd_start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "ssd_step_ms": {
          "$ref": "#/definitions/ms"
        },
        "trials": {
          "type": "array",
          "minItems": 2,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dir",
              "stop"
            ],
            "properties": {
              "dir": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "stop": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "PalParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boxes",
        "study_ms",
        "time_limit_ms",
        "max_attempts",
        "stages"
      ],
      "$comment": "Pair Finder (PairedAssociates.tsx): 8 shapes (pattern 0..7); boxes 2..8, keys 1..8 pick one.",
      "properties": {
        "boxes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "study_ms": {
          "$ref": "#/definitions/ms"
        },
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "items",
              "recall"
            ],
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pattern",
                    "box"
                  ],
                  "properties": {
                    "pattern": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    },
                    "box": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 7
                    }
                  }
                }
              },
              "recall": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 7
                }
              }
            }
          }
        }
      }
    },
    "FlankerParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_limit_ms",
        "fixation_ms",
        "trials"
      ],
      "$comment": "Arrow Focus (Flanker.tsx): five arrows, the answer is the middle one's dir.",
      "properties": {
        "time_limit_ms": {
          "$ref": "#/definitions/ms"
        },
        "fixation_ms": {
          "$ref": "#/definitions/ms"
        },
        "trials": {
          "type": "array",
          "minItems": 2,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dir",
              "congruent"
            ],
            "properties": {
              "dir": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "congruent": {
                "type": "boolean"
              },
              "cue": {
                "enum": [
                  "center",
                  "spatial"
                ]
              }
            }
          }
        }
      }
    }
  }
}
