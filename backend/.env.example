# SynapseTwin API configuration. All optional.
# Copy to backend/.env (gitignored); the server reads it at startup. Real environment variables win.

# Comma-separated origins allowed by CORS. The Vite dev server by default.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Where POST /v1/telemetry/event appends {user_id}.jsonl (ids lowercased), and where the privacy
# routes and the retention job look. Default: <repo>/data/raw/telemetry
# TELEMETRY_DIR=

# Where GET /v1/tasks/next keeps one {user_id}.json per user (14-day seen filter, session answers,
# difficulty staircase). The privacy delete removes it; the export includes it.
# Default: <repo>/data/processed/task_registry
# TASK_REGISTRY_DIR=

# Retention in whole days (at least 1): the retention CLI's default for telemetry, coach chat
# history and task registries, and how long the server keeps an idle user's task registry.
# Default: 30
# RETENTION_DAYS=

# Where the coach chat history is kept, {user_id}.jsonl. Covered by the privacy delete and export
# and by retention. Default: <repo>/data/processed/coach
# COACH_DIR=

# Gemini key for Loti's coach and its backup crisis classifier; empty means scripted replies only.
GEMINI_API_KEY=
# Gemini model id. Default: gemini-2.5-flash
# GEMINI_MODEL=
