# Toggle between deterministic MSW/seeded fixtures ("true") and live FastAPI backend ("false")
VITE_USE_MOCKS=true

# Backend API origin (proxied or direct)
VITE_API_BASE_URL=http://localhost:8000

# Set only by Playwright's own build (playwright.config.ts webServer): turns on the baseline's
# ?fast=1 e2e hook (src/features/flow/baseline.ts). Never set it for a real build.
# VITE_E2E=1
